{
  "manifest_version": 3,
  "name": "IITM BS Question Papers Downloader",
  "version": "1.0.0",
  "description": "Batch downloads IITM BS Data Science exam papers from student Google Drive and Google Docs links.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "IITM BS Papers Downloader"
  },
  "permissions": [
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://drive.google.com/*",
    "https://docs.google.com/*",
    "https://drive.usercontent.google.com/*",
    "http://localhost:8000/*"
  ]
}
